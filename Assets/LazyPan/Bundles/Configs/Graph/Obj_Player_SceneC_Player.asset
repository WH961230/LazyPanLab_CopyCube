        "\u53C2\u6570\u4FBF\u7B7E": "\u3010\u63A7\u5236\u5668\u524D\u540E\u5DE6\u53F3\u79FB\u52A8\u3011\r\n\u3010\u63A7\u5236\u5668\u79FB\u52A8\u3011\u7BA1\u4E00\u4E2A\u5B9E\u4F53\u7684
          WASD \u8D70\u8DEF\uFF0C\u8BFB\u8F93\u5165\u3001\u63A8 CharacterController\uFF0C\u4E0D\u8C03\u522B\u7684\u79FB\u52A8\u884C\u4E3A\u3002\n\u505C\u8D70\u547D\u4EE4\u770B\u5B9E\u4F53\u7EA7
          MoveAttr\uFF0C\u8C01\u7F6E\u505C\u90FD\u505C\u3002\n\u2014 \u914D\u7F6E\u53C2\u6570\uFF08InputWASDMoveSetting
          \u91CC\u6309 SourceSign \u914D\uFF09\u2014\n- <color=#FFD54F>InputControlSign</color>\uFF1A\u8F93\u5165\u65B9\u6848\u540D\uFF0C\u586B
          InputRegister \u91CC\u7684\u90A3\u4E00\u4E2A\uFF0C\u9519\u4E86\u5C31\u6CA1\u53CD\u5E94\n-
          <color=#FFD54F>MoveSpeed</color>\uFF1A\u79FB\u52A8\u901F\u5EA6\uFF0C0=\u4E0D\u52A8\uFF0C\u5EFA\u8BAE
          3~8\n- <color=#FFD54F>RotateSpeed</color>\uFF1A\u8F6C\u5411\u901F\u5EA6\uFF0C0=\u4E0D\u8F6C\u8EAB\uFF0C\u5EFA\u8BAE
          5~15\n- <color=#FFD54F>Gravity</color>\uFF1A\u91CD\u529B\u52A0\u901F\u5EA6\uFF0C\u4E00\u822C\u586B\u8D1F\u6570\uFF08\u5982
