  m_Name: StageProgressSetting
  m_EditorClassIdentifier: 
  MemoDoc: "\u3010\u9636\u6BB5\u8FDB\u5EA6\u3011\u7BA1\u5347\u7EA7\u90A3\u5957\u6570\uFF0C\u8FDB\u5EA6\u88C5\u6EE1\u81EA\u52A8\u5347\u4E00\u6BB5\uFF0C\u591A\u7684\u8FDB\u5EA6\u5E26\u5230\u4E0B\u4E00\u6BB5\u3002\n\u2014
    \u914D\u7F6E\u53C2\u6570\uFF08StageProgressSetting \u91CC\u6309 SourceSign \u914D\uFF09\u2014\n-
    <color=#FFD54F>StageParamSign</color>\uFF1A\u6BB5\u6570\u5B58\u54EA\u4E2A\u6807\u7B7E\uFF0CInt
    \u7C7B\u578B\n- <color=#FFD54F>ProgressParamSign</color>\uFF1A\u8FDB\u5EA6\u5B58\u54EA\u4E2A\u6807\u7B7E\uFF0CFloat
    \u7C7B\u578B\n- <color=#FFD54F>InitialStage</color>\uFF1A\u5F00\u5C40\u7B2C\u51E0\u6BB5\n-
    <color=#FFD54F>MaxStage</color>\uFF1A\u6EE1\u7EA7\u7B2C\u51E0\u6BB5\uFF0C\u5C01\u9876\n-
    <color=#FFD54F>FallbackCap</color>\uFF1A\u8868\u91CC\u6CA1\u5199\u7684\u6BB5\u7EDF\u4E00\u6309\u8FD9\u4E2A\u7B97\n-
    <color=#FFD54F>Caps</color>\uFF1A\u6BCF\u6BB5\u4E0A\u9650\u8868\uFF0C\u4E00\u6761\u4E00\u6BB5\n-
    <color=#FFD54F>MaxStageParamSign</color>+<color=#FFD54F>MaxProgressParamSign</color>\uFF1A\u9009\u586B\uFF0C\u7A7A=\u4E0D\u540C\u6B65\n\u2014
    \u5916\u90E8\u600E\u4E48\u4E92\u52A8 \u2014\n- <color=#FFD54F>\u52A0\u8FDB\u5EA6</color>\uFF1A\u53EA\u7BA1\u5F80\u8FDB\u5EA6\u91CC\u52A0\u6570\uFF0C\u5347\u6BB5\u5B83\u81EA\u5DF1\u7B97"
