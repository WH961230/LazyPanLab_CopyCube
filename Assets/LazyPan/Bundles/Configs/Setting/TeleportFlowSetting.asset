%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 725274dcad12b2b4c80dc2d15fc8f132, type: 3}
  m_Name: TeleportFlowSetting
  m_EditorClassIdentifier: 
  MemoDoc: "【传送流程】管条件一到跳场景。\n— 配置参数（TeleportFlowSetting 里按 SourceSign 配）—\n- <color=#FFD54F>TargetSceneSign</color>：跳去哪个场景\n- <color=#FFD54F>Once</color>：true=只跳一次\n- <color=#FFD54F>Condition</color>：前置条件，空=谁喊跳谁跳\n— 条件怎么填 —\n- <color=#FFD54F>LeftEntitySign</color>+<color=#FFD54F>LeftParamSign</color>：看谁的哪个数，Self=自己\n- <color=#FFD54F>Compare</color>：比大小的方式\n- <color=#FFD54F>RightIsEntityParam</color>：true=右边也是数，false=右边是常量\n- 右边是常量时，对着类型填下面的值"
  Datas:
  - SourceSign: Obj_Tower_SceneB_Tower
    TargetSceneSign: SceneC
    Once: 1
    Condition:
      LeftEntitySign: Obj_Tower_SceneB_Tower
      LeftParamSign: Energy
      LeftValueType: 2
      Compare: 2
      RightIsEntityParam: 1
      RightEntitySign: Obj_Tower_SceneB_Tower
      RightParamSign: MaxEnergy
      RightValueType: 2
      RightBoolValue: 0
      RightIntValue: 0
      RightConstValue: 0
      RightStringValue: 
      RightVector3Value: {x: 0, y: 0, z: 0}
      RightConstType: 2
  - SourceSign: Obj_Logo_SceneA_BeginLogo
    TargetSceneSign: SceneB
    Once: 1
    Condition:
      LeftEntitySign: Obj_Logo_SceneA_BeginLogo
      LeftParamSign: LogoRemainTime
      LeftValueType: 2
      Compare: 2
      RightIsEntityParam: 0
      RightEntitySign: Self
      RightParamSign: None
      RightValueType: 2
      RightBoolValue: 0
      RightIntValue: 0
      RightConstValue: 0
      RightStringValue: 
      RightVector3Value: {x: 0, y: 0, z: 0}
      RightConstType: 2
