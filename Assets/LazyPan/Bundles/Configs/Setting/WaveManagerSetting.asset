  m_Name: WaveManagerSetting
  m_EditorClassIdentifier: 
  MemoDoc: "\u3010\u6CE2\u6B21\u3011\u7BA1\u602A\u4E00\u6CE2\u4E00\u6CE2\u4E0A\uFF0C\u7B2C\u51E0\u6CE2\u5199\u5230
    WaveIndex \u4F9B\u4EA7\u602A\u70B9\u76EF\u7740\u770B\u3002\n\u2014 \u914D\u7F6E\u53C2\u6570\uFF08WaveManagerSetting
    \u91CC\u6309 SourceSign \u914D\uFF09\u2014\n- <color=#FFD54F>StartWaveIndex</color>\uFF1A\u4ECE\u7B2C\u51E0\u6CE2\u5F00\u59CB\uFF0C\u9ED8\u8BA4
    1\n- <color=#FFD54F>InitialDelay</color>\uFF1A\u9996\u6CE2\u524D\u7B49\u51E0\u79D2\uFF0C0=\u7ACB\u5373\u5F00\u59CB\n-
    <color=#FFD54F>Loop</color>\uFF1Atrue=\u5168\u6253\u5B8C\u518D\u4ECE\u5934\u6765\n-
    <color=#FFD54F>Waves</color>\uFF1A\u6CE2\u6B21\u5217\u8868\uFF0C\u6309\u987A\u5E8F\u6253\n\u2014
    \u6BCF\u6CE2\u600E\u4E48\u586B \u2014\n- <color=#FFD54F>RestDuration</color>\uFF1A\u672C\u6CE2\u6253\u5B8C\u6B47\u51E0\u79D2\uFF0C0=\u7ACB\u523B\u4E0B\u4E00\u6CE2\n-
    <color=#FFD54F>AdvanceMode</color>\uFF1A\u8FDB\u4E0B\u4E00\u6CE2\u7684\u6761\u4EF6\n-
    <color=#FFD54F>WaitWatchSign</color>+<color=#FFD54F>WaitWatchEntitySign</color>\uFF1A\u76EF\u7740\u8C01\u7684\u54EA\u4E2A\u6570\uFF0C\u5982\u4EA7\u602A\u70B9\u7684
    LivingCount\n- <color=#FFD54F>WaitTargetValue</color>+<color=#FFD54F>Compare</color>\uFF1A\u6570\u5230\u591A\u5C11\u7B97\u6253\u5B8C\uFF0C\u5982
    =0"
  Datas:
  - SourceSign: Obj_Wave_SceneC_WaveManager
    StartWaveIndex: 1
    InitialDelay: 1
    Loop: 0
    Waves:
    - RestDuration: 3
