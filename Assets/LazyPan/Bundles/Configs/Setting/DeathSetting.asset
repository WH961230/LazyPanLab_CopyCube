  m_Name: DeathSetting
  m_EditorClassIdentifier: 
  MemoDoc: "\u3010\u6B7B\u4EA1\u3011\u7BA1\u4E00\u4E2A\u5B9E\u4F53\u7684\u6B7B\u6D3B\uFF0C\u6709\u8840\u6761\u6309\u8840\u91CF\u81EA\u52A8\u6B7B\uFF0C\u65E0\u8840\u6761\u9760\u5916\u90E8\u558A\u6B7B\u3002\n\u2014
    \u914D\u7F6E\u53C2\u6570\uFF08DeathSetting \u91CC\u6309 SourceSign \u914D\uFF09\u2014\n-
    <color=#FFD54F>Health</color>\uFF1A\u521D\u59CB\u8840\u91CF\uFF0C\u6709\u8840\u6761\uFF08\u4EBA/\u602A/\u5854\uFF09\u586B\u6B63\u6570\uFF0C\u65E0\u8840\u6761\uFF08\u5B50\u5F39/\u7279\u6548\uFF09\u586B
    0\n- <color=#FFD54F>MaxHealth</color>\uFF1A\u6700\u5927\u8840\u91CF\uFF0C0=\u65E0\u8840\u6761\u6A21\u5F0F\uFF0C\u53EA\u9760\u5916\u90E8\u558A\u6B7B\uFF1B>0=\u6709\u8840\u6761\uFF0C\u8840\u91CF<=0
    \u81EA\u52A8\u6B7B\uFF0C\u8840\u91CF\u56DE\u6B63\u81EA\u52A8\u6D3B\n- <color=#FFD54F>DeathDelay</color>\uFF1A\u6B7B\u540E\u5EF6\u8FDF\u51E0\u79D2\u518D\u6267\u884C
    DeathAction\uFF0C0=\u7ACB\u5373\u6267\u884C\n- <color=#FFD54F>DeathAction</color>\uFF1ANone=\u53EA\u6807\u8BB0\u4E0D\u5904\u7406\uFF0CDestroyEntity=\u9500\u6BC1\u5B9E\u4F53\uFF0CDisableEntity=\u5931\u6D3B\u9884\u5236\u4F53\n-
    <color=#FFD54F>OnDeathParams</color>\uFF1A\u6B7B\u7684\u4E00\u77AC\u95F4\u987A\u624B\u6539\u4E00\u6279\u53C2\u6570\uFF0C\u4E00\u6761\u6539\u4E00\u4E2A\u5B9E\u4F53\u7684\u4E00\u4E2A\u6570\uFF08\u6BD4\u5982\u654C\u4EBA\u6B7B\u540E\u7ED9\u73A9\u5BB6\u52A0
    40 \u5206\uFF09\uFF0C\u4E3A\u7A7A=\u5565\u4E5F\u4E0D\u6539\n\u2014 \u5916\u90E8\u600E\u4E48\u4E92\u52A8
    \u2014\n- <color=#FFD54F>\u6263\u8840</color>\uFF1A\u6709\u8840\u6761\u65F6\u628A
    Health \u5F80\u4E0B\u6539\uFF0C<=0 \u81EA\u52A8\u6B7B\uFF1B\u65E0\u8840\u6761\u65F6\u6263\u8840\u6CA1\u7528\n-
    <color=#FFD54F>\u558A\u6B7B/\u590D\u6D3B</color>\uFF1A\u628A Dead \u7F6E true=\u558A\u6B7B\uFF0C\u7F6E
    false=\u590D\u6D3B\uFF1B\u6709\u8840\u6761\u590D\u6D3B\u524D\u5148\u628A Health
    \u56DE\u6B63"
